# Copy to .env (never commit it) and export the variables, or set them in your IDE / deployment.
APP_NAME=my-service
SERVER_PORT=8080

# Database (use DB_URL instead of HOST/PORT/NAME to point at any JDBC URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
# DB_URL=jdbc:postgresql://localhost:5432/app_db
# DB_POOL_MAX_SIZE=10
# JPA_DDL_AUTO=none
# FLYWAY_ENABLED=true

# Optional authentication (default: disabled, all endpoints public)
APP_AUTH_ENABLED=false
# Required when enabled, at least 32 characters:  openssl rand -base64 48
APP_AUTH_JWT_SECRET=
APP_AUTH_ACCESS_TTL=15m
APP_AUTH_REFRESH_TTL=7d
# false only for local http development
APP_AUTH_COOKIE_SECURE=true

# Comma separated origins allowed by CORS (empty = disabled)
APP_CORS_ALLOWED_ORIGINS=
